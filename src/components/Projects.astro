---
import { projects, socialLinks } from '../data/content';
import Arrow from './Arrow.astro';
import { closeSvg } from '../scripts/icons';

const github = socialLinks.find((s) => s.label === 'GitHub')?.href ?? '#';
const initials = (t: string) =>
  t
    .split(/[\s-]+/)
    .map((w) => w[0])
    .join('')
    .slice(0, 3);
---

<section class="projects" id="projects">
  <div class="projects__pin">
    <div class="projects__head wrap">
      <div>
        <div class="sec-label" data-reveal>
          <span class="sec-label__idx">(04)</span>
          <span class="sec-label__rule" data-line></span>
          <span data-scramble>Selected work</span>
        </div>
        <h2 class="sec-title display projects__title" data-split>
          Things I've <span class="serif">shipped</span>
        </h2>
      </div>
      <div class="projects__counter mono" aria-hidden="true">
        <span class="projects__count" id="proj-count">01</span>
        <span class="projects__bar"><span class="projects__bar-fill" id="proj-bar"></span></span>
        <span>{String(projects.length).padStart(2, '0')}</span>
      </div>
    </div>

    <div class="projects__viewport">
      <div class="projects__track" id="proj-track">
        {
          projects.map((project, i) => (
            <article
              class={`pcard ${i % 2 === 0 ? 'pcard--accent' : 'pcard--dark'}`}
              data-title={project.title}
              data-desc={project.description}
              data-tags={JSON.stringify(project.tags)}
              data-highlights={JSON.stringify(project.highlights ?? [])}
              data-link={project.link ?? ''}
              data-link-label={project.linkLabel ?? ''}
              data-index={`0${i + 1}`}
              data-cursor="Details +"
              role="button"
              tabindex="0"
              aria-label={`View details for ${project.title}`}
            >
              <div class="pcard__cover" aria-hidden="true">
                <div class="pcard__cover-inner" data-hparallax>
                  <span class="pcard__initials display">{project.cover ?? initials(project.title)}</span>
                </div>
                <span class="pcard__grid" />
                <span class="pcard__num display">0{i + 1}</span>
                <ul class="pcard__cover-tags mono">
                  {project.tags.slice(0, 3).map((t) => (
                    <li>{t}</li>
                  ))}
                </ul>
              </div>
              <div class="pcard__body">
                <span class="mono pcard__kicker">
                  Project 0{i + 1} / {String(projects.length).padStart(2, '0')}
                </span>
                <h3 class="pcard__title display">{project.title}</h3>
                <p class="pcard__desc">{project.description}</p>
                <ul class="pcard__tags">
                  {project.tags.map((t) => (
                    <li class="tag">{t}</li>
                  ))}
                </ul>
                <div class="pcard__actions">
                  {project.link && (
                    <a
                      class="pill pill--solid"
                      href={project.link}
                      target="_blank"
                      rel="noopener noreferrer"
                      data-cursor="Visit ↗"
                    >
                      <span class="roll">
                        <span data-text={project.linkLabel ?? 'Visit'}>
                          {project.linkLabel ?? 'Visit'}
                        </span>
                      </span>
                      <span class="pill__arrow" aria-hidden="true"><Arrow /></span>
                    </a>
                  )}
                  <span class="pcard__more mono">Click for details +</span>
                </div>
              </div>
            </article>
          ))
        }
        <a
          class="pcard pcard--end"
          href={github}
          target="_blank"
          rel="noopener noreferrer"
          data-cursor="GitHub ↗"
        >
          <span class="mono">More experiments</span>
          <span class="pcard__end-title display">
            See it all <span class="serif">on</span> GitHub
          </span>
          <span class="pcard__end-arrow" aria-hidden="true"><Arrow /></span>
        </a>
      </div>
    </div>
  </div>

  <div class="pmodal" id="pmodal" aria-hidden="true">
    <div class="pmodal__backdrop" data-close></div>
    <article class="pmodal__panel" role="dialog" aria-modal="true" aria-labelledby="pmodal-title">
      <button class="pmodal__close" data-close aria-label="Close"><Fragment set:html={closeSvg()} /></button>
      <span class="pmodal__index mono" id="pmodal-index"></span>
      <h3 class="pmodal__title display" id="pmodal-title"></h3>
      <p class="pmodal__desc" id="pmodal-desc"></p>
      <ul class="pmodal__highlights" id="pmodal-highlights"></ul>
      <ul class="pmodal__tags" id="pmodal-tags"></ul>
      <a class="pill pill--solid pmodal__cta" id="pmodal-cta" target="_blank" rel="noopener noreferrer"></a>
    </article>
  </div>
</section>

<style>
  .projects {
    position: relative;
    background: var(--veil);
  }

  .projects__pin {
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    gap: clamp(1.5rem, 4vh, 3rem);
    padding: calc(var(--header-h) + 1rem) 0 clamp(1.5rem, 4vh, 3rem);
    overflow: hidden;
  }

  .projects__head {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    padding: 0 var(--gutter);
  }

  .projects__head .sec-label {
    margin-bottom: 1.2rem;
  }

  .projects__title {
    font-size: clamp(3rem, 8vw, 8rem);
  }

  .projects__counter {
    display: flex;
    align-items: center;
    gap: 0.8rem;
    color: var(--ink-2);
    padding-bottom: 0.6rem;
  }

  .projects__count {
    color: var(--accent-text);
    font-variant-numeric: tabular-nums;
  }

  .projects__bar {
    position: relative;
    width: clamp(80px, 12vw, 180px);
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .projects__bar-fill {
    position: absolute;
    inset: 0;
    background: var(--accent-text);
    transform: scaleX(0);
    transform-origin: left center;
  }

  .projects__track {
    display: flex;
    gap: clamp(1rem, 2vw, 2rem);
    width: max-content;
    padding: 0 var(--gutter);
    will-change: transform;
  }

  /* ----- Card ----- */
  .pcard {
    position: relative;
    flex: 0 0 auto;
    width: min(82vw, 1080px);
    height: clamp(380px, 58vh, 620px);
    display: grid;
    grid-template-columns: minmax(0, 1fr) minmax(0, 1fr);
    border-radius: var(--radius);
    overflow: hidden;
    background: var(--surface);
    border: 1px solid var(--line);
  }

  .pcard__cover {
    position: relative;
    overflow: hidden;
    background: var(--accent);
    color: var(--on-accent);
  }

  .pcard--dark .pcard__cover {
    background: var(--ink);
    color: var(--bg);
  }

  .pcard__cover-inner {
    position: absolute;
    inset: 0 -20%;
    display: grid;
    place-items: center;
    will-change: transform;
  }

  .pcard__initials {
    font-size: clamp(9rem, 22vw, 22rem);
    font-weight: 900;
    font-stretch: 62%;
    line-height: 0.8;
    letter-spacing: -0.04em;
    transition: transform 0.9s var(--ease-out);
  }

  .pcard:hover .pcard__initials {
    transform: scale(1.06) rotate(-2deg);
  }

  .pcard__grid {
    position: absolute;
    inset: 0;
    background-image:
      linear-gradient(currentColor 1px, transparent 1px),
      linear-gradient(90deg, currentColor 1px, transparent 1px);
    background-size: 44px 44px;
    opacity: 0.09;
  }

  .pcard__num {
    position: absolute;
    top: 1.1rem;
    left: 1.3rem;
    font-size: 1.6rem;
  }

  .pcard__cover-tags {
    position: absolute;
    left: 1.3rem;
    right: 1.3rem;
    bottom: 1.1rem;
    display: flex;
    flex-wrap: wrap;
    gap: 0.3rem 1rem;
    font-size: 0.64rem;
  }

  .pcard__body {
    display: flex;
    flex-direction: column;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    gap: 1.1rem;
  }

  .pcard__kicker {
    color: var(--ink-3);
  }

  .pcard__title {
    font-size: clamp(2.4rem, 4.6vw, 4.6rem);
    line-height: 0.88;
  }

  .pcard__desc {
    font-size: clamp(0.95rem, 1.1vw, 1.08rem);
    line-height: 1.55;
    flex-grow: 1;
  }

  .pcard__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.4rem;
  }

  .pcard__actions {
    display: flex;
    flex-wrap: wrap;
    align-items: center;
    gap: 1rem 1.5rem;
  }

  .pcard__more {
    color: var(--ink-3);
    transition: color 0.3s ease;
  }

  .pcard:hover .pcard__more {
    color: var(--accent-text);
  }

  /* ----- End card ----- */
  .pcard--end {
    width: min(60vw, 620px);
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    padding: clamp(1.5rem, 3vw, 2.75rem);
    background: transparent;
    border: 1px dashed var(--line-strong);
    color: var(--ink);
    transition: background 0.5s var(--ease-out), color 0.5s var(--ease-out);
  }

  .pcard--end .mono {
    color: inherit;
    opacity: 0.6;
  }

  .pcard--end:hover {
    background: var(--accent);
    color: var(--on-accent);
  }

  .pcard__end-title {
    font-size: clamp(3rem, 6vw, 6rem);
  }

  .pcard__end-title .serif {
    color: var(--accent-text);
  }

  .pcard--end:hover .pcard__end-title .serif {
    color: inherit;
  }

  .pcard__end-arrow {
    align-self: flex-end;
    font-size: clamp(4rem, 8vw, 8rem);
    line-height: 1;
    transition: transform 0.6s var(--ease-out);
  }

  .pcard--end:hover .pcard__end-arrow {
    transform: rotate(45deg);
  }

  /* Mobile / tablet / reduced motion: plain vertical stack, no pin. */
  @media (max-width: 900px), (prefers-reduced-motion: reduce) {
    .projects__pin {
      min-height: 0;
      padding: clamp(4rem, 10vh, 6rem) 0;
    }
    .projects__counter {
      display: none;
    }
    .projects__track {
      flex-direction: column;
      width: auto;
    }
    .pcard,
    .pcard--end {
      width: 100%;
      height: auto;
      grid-template-columns: 1fr;
    }
    .pcard__cover {
      aspect-ratio: 16 / 9;
    }
    .pcard--end {
      min-height: 280px;
    }
  }

  /* ----- Project detail modal ----- */
  .pmodal {
    position: fixed;
    inset: 0;
    z-index: 200;
    display: none;
  }

  .pmodal.is-open {
    display: flex;
    align-items: center;
    justify-content: center;
    padding: 1.5rem;
  }

  .pmodal__backdrop {
    position: absolute;
    inset: 0;
    background: rgba(5, 10, 20, 0.74);
    backdrop-filter: blur(6px);
    opacity: 0;
  }

  .pmodal__panel {
    position: relative;
    width: min(680px, 92vw);
    max-height: 86vh;
    overflow-y: auto;
    background: var(--surface);
    border: 1px solid var(--line-strong);
    border-radius: var(--radius);
    padding: clamp(1.75rem, 4vw, 3rem);
    box-shadow: 0 30px 80px rgba(0, 0, 0, 0.5);
    will-change: transform, opacity;
  }

  .pmodal__close {
    position: absolute;
    top: 1rem;
    right: 1.1rem;
    width: 40px;
    height: 40px;
    border-radius: 50%;
    display: grid;
    place-items: center;
    border: 1px solid var(--line-strong);
    color: var(--ink);
    font-size: 1.15rem;
    line-height: 1;
    transition: background 0.3s ease, color 0.3s ease, transform 0.4s var(--ease-out);
  }

  .pmodal__close:hover {
    background: var(--accent);
    color: var(--on-accent);
    transform: rotate(90deg);
  }

  .pmodal__index {
    color: var(--accent-text);
  }

  .pmodal__title {
    font-size: clamp(2.4rem, 5vw, 4rem);
    margin: 0.6rem 0 1rem;
  }

  .pmodal__desc {
    font-size: 1rem;
    line-height: 1.65;
    margin-bottom: 1.5rem;
  }

  .pmodal__highlights {
    display: flex;
    flex-direction: column;
    margin-bottom: 1.5rem;
    border-top: 1px solid var(--line);
  }

  .pmodal__highlights :global(li) {
    padding: 0.8rem 0 0.8rem 1.6rem;
    position: relative;
    border-bottom: 1px solid var(--line);
    color: var(--ink);
  }

  .pmodal__highlights :global(li)::before {
    content: '';
    position: absolute;
    left: 0;
    top: calc(0.8rem + 0.3em);
    width: 0.8em;
    height: 0.8em;
    background-color: var(--accent-text);
    -webkit-mask: url('/icons/star.svg') center / contain no-repeat;
    mask: url('/icons/star.svg') center / contain no-repeat;
  }

  .pmodal__tags {
    display: flex;
    flex-wrap: wrap;
    gap: 0.45rem;
    margin-bottom: 1.75rem;
  }

  .pmodal__cta[hidden] {
    display: none;
  }
</style>

<script>
  import gsap from 'gsap';
  import { lenisInstance } from '@/scripts/smooth-scroll';
  import { setArrowLabel } from '@/scripts/icons';

  const modal = document.getElementById('pmodal');
  const panel = modal?.querySelector<HTMLElement>('.pmodal__panel');
  const backdrop = modal?.querySelector<HTMLElement>('.pmodal__backdrop');
  const cards = Array.from(document.querySelectorAll<HTMLElement>('.pcard[data-title]'));

  if (modal && panel && backdrop && cards.length) {
    const elIndex = document.getElementById('pmodal-index')!;
    const elTitle = document.getElementById('pmodal-title')!;
    const elDesc = document.getElementById('pmodal-desc')!;
    const elHighlights = document.getElementById('pmodal-highlights')!;
    const elTags = document.getElementById('pmodal-tags')!;
    const elCta = document.getElementById('pmodal-cta') as HTMLAnchorElement;

    let activeCard: HTMLElement | null = null;
    let isOpen = false;

    const parse = (v: string | undefined): string[] => {
      try {
        return JSON.parse(v || '[]');
      } catch {
        return [];
      }
    };

    function fillList(ul: HTMLElement, items: string[], cls: string) {
      ul.innerHTML = '';
      for (const item of items) {
        const li = document.createElement('li');
        if (cls) li.className = cls;
        li.textContent = item;
        ul.appendChild(li);
      }
    }

    function open(card: HTMLElement) {
      activeCard = card;
      const d = card.dataset;
      elIndex.textContent = `Project ${d.index || ''}`;
      elTitle.textContent = d.title || '';
      elDesc.textContent = d.desc || '';
      fillList(elHighlights, parse(d.highlights), '');
      fillList(elTags, parse(d.tags), 'tag');
      if (d.link) {
        elCta.href = d.link;
        setArrowLabel(elCta, `${d.linkLabel || 'Visit'} ↗`);
        elCta.hidden = false;
      } else {
        elCta.hidden = true;
      }

      modal!.classList.add('is-open');
      modal!.setAttribute('aria-hidden', 'false');
      lenisInstance.stop();
      isOpen = true;

      const cr = card.getBoundingClientRect();
      const pr = panel!.getBoundingClientRect();
      const dx = cr.left + cr.width / 2 - (pr.left + pr.width / 2);
      const dy = cr.top + cr.height / 2 - (pr.top + pr.height / 2);

      gsap.killTweensOf([panel, backdrop]);
      gsap.set(panel, { x: dx, y: dy, scale: 0.6, opacity: 0, rotate: -3 });
      gsap.to(backdrop, { opacity: 1, duration: 0.4, ease: 'power2.out' });
      gsap.to(panel, {
        x: 0,
        y: 0,
        scale: 1,
        rotate: 0,
        opacity: 1,
        duration: 0.7,
        ease: 'expo.out',
      });
      gsap.fromTo(
        panel!.children,
        { y: 24, opacity: 0 },
        { y: 0, opacity: 1, duration: 0.6, stagger: 0.04, ease: 'power3.out', delay: 0.12 }
      );
      panel!.querySelector<HTMLElement>('.pmodal__close')?.focus({ preventScroll: true });
    }

    function close() {
      if (!isOpen) return;
      isOpen = false;
      const cr = activeCard?.getBoundingClientRect();
      const pr = panel!.getBoundingClientRect();
      const dx = cr ? cr.left + cr.width / 2 - (pr.left + pr.width / 2) : 0;
      const dy = cr ? cr.top + cr.height / 2 - (pr.top + pr.height / 2) : 40;

      gsap.killTweensOf([panel, backdrop]);
      gsap.to(backdrop, { opacity: 0, duration: 0.4, ease: 'power2.in' });
      gsap.to(panel, {
        x: dx,
        y: dy,
        scale: 0.6,
        opacity: 0,
        duration: 0.45,
        ease: 'power3.in',
        onComplete: () => {
          modal!.classList.remove('is-open');
          modal!.setAttribute('aria-hidden', 'true');
          lenisInstance.start();
          activeCard?.focus({ preventScroll: true });
        },
      });
    }

    cards.forEach((card) => {
      card.addEventListener('click', (e) => {
        // Let the real "live demo" link work without opening the modal.
        if ((e.target as HTMLElement).closest('a')) return;
        open(card);
      });
      card.addEventListener('keydown', (e) => {
        if (e.target !== card) return;
        if (e.key === 'Enter' || e.key === ' ') {
          e.preventDefault();
          open(card);
        }
      });
    });

    modal.querySelectorAll('[data-close]').forEach((el) => el.addEventListener('click', close));
    window.addEventListener('keydown', (e) => {
      if (e.key === 'Escape') close();
    });
  }
</script>
