---
// Cursor: a native custom pointer (an arrowhead, no stem) drawn by the browser
// itself, so it tracks the mouse 1:1 with no lag or trailing ring. It turns red
// over anything clickable. The intent label ("Visit ↗") is the only JS-driven
// piece and sits right beside the pointer.
---

<span class="cursor-label" id="cursor-label" aria-hidden="true"></span>

<style>
  /* Fine pointers only — touch devices keep their default behaviour. The SVG
     is preferred; the PNG is a fallback for browsers without SVG cursors. */
  @media (hover: hover) and (pointer: fine) {
    :global(html) {
      cursor:
        url('/cursors/pointer-dark.svg') 4 3,
        url('/cursors/pointer-dark.png') 4 3,
        auto;
    }

    :global([data-theme='light']) {
      cursor:
        url('/cursors/pointer-light.svg') 4 3,
        url('/cursors/pointer-light.png') 4 3,
        auto;
    }

    :global(:is(a, button, summary, label, select, [role='button'], [data-close], .magnetic, [data-cursor])),
    :global(:is(a, button, summary, label, select, [role='button'], [data-close], .magnetic, [data-cursor]) *) {
      cursor:
        url('/cursors/pointer-active.svg') 4 3,
        url('/cursors/pointer-active.png') 4 3,
        pointer;
    }

    /* Text fields keep the I-beam so typing feels normal. */
    :global(:is(input, textarea)) {
      cursor: text;
    }
  }

  .cursor-label {
    position: fixed;
    top: 0;
    left: 0;
    z-index: 9999;
    display: inline-flex;
    align-items: center;
    gap: 0.35rem;
    padding: 0.4rem 0.7rem;
    border-radius: 999px;
    background: var(--accent);
    color: var(--on-accent);
    font-family: var(--font-mono);
    font-size: 0.62rem;
    font-weight: 500;
    letter-spacing: 0.06em;
    text-transform: uppercase;
    white-space: nowrap;
    pointer-events: none;
    opacity: 0;
    scale: 0.7;
    transform-origin: left top;
    transition: opacity 0.2s ease, scale 0.3s var(--ease-out);
    will-change: transform;
  }

  :global(body.cursor-label-on) .cursor-label {
    opacity: 1;
    scale: 1;
  }

  @media (hover: none), (pointer: coarse) {
    .cursor-label {
      display: none;
    }
  }
</style>

<script>
  import '@/scripts/cursor';
</script>
