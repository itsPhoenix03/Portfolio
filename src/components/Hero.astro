---
import { siteMeta } from '../data/content';
---

<section class="hero" id="hero">
  <div class="hero__top mono">
    <span class="hero__fade">( Portfolio — {new Date().getFullYear()} )</span>
    <span class="hero__fade hero__top-mid">{siteMeta.role} / Full-Stack</span>
    <span class="hero__fade">{siteMeta.location} · GMT+5:30</span>
  </div>

  <h1 class="hero__name display" id="hero-name" aria-label={siteMeta.name}>
    <span class="hero__line hero__line--1" aria-hidden="true">
      <span class="hero__word" data-hero-split>Shreyas</span>
    </span>
    <span class="hero__line hero__line--2" aria-hidden="true">
      <span class="hero__aside">
        <span class="hero__avatar hero__fade">
          <img
            src="/assets/pixton-avatar-headshot.png"
            alt=""
            width="160"
            height="160"
            decoding="async"
          />
        </span>
        <span class="hero__intro hero__fade">
          Building <em class="serif">scalable</em>, <em class="serif">dependable</em> systems —
          from fine-tuned AI pipelines to full-stack products people rely on.
        </span>
      </span>
      <span class="hero__word hero__word--outline">
        <span class="hero__outline" data-hero-split>Misra</span>
        <span class="hero__fill" aria-hidden="true">Misra</span>
      </span>
    </span>
  </h1>

  <div class="hero__bottom mono">
    <span class="hero__fade hero__now">
      <i class="hero__dot"></i>Currently — {siteMeta.currently}
    </span>
    <a href="#about" class="hero__scroll hero__fade" data-nav="about" data-cursor="Scroll">
      <span>Scroll</span>
      <span class="hero__scroll-line"><i></i></span>
    </a>
  </div>
</section>

<style>
  .hero {
    position: relative;
    min-height: 100vh;
    min-height: 100svh;
    display: flex;
    flex-direction: column;
    justify-content: space-between;
    gap: 2rem;
    padding: calc(var(--header-h) + 1.5rem) var(--gutter) 1.6rem;
    overflow: hidden;
  }

  .hero__top {
    display: flex;
    justify-content: space-between;
    gap: 1rem;
    color: var(--ink-2);
  }

  .hero__name {
    /* --fit is computed in JS so "SHREYAS" spans the full viewport width. */
    font-size: var(--fit, 20vw);
    font-weight: 900;
    font-stretch: 68%;
    line-height: 0.8;
    letter-spacing: -0.02em;
    display: flex;
    flex-direction: column;
    gap: 0.02em;
    color: var(--ink);
  }

  .hero__line {
    display: flex;
    align-items: flex-end;
    white-space: nowrap;
    will-change: transform;
  }

  .hero__line--2 {
    justify-content: space-between;
    gap: 2rem;
  }

  .hero__word {
    display: inline-block;
    position: relative;
  }

  /* Outlined "MISRA" with an accent fill that wipes in after the entrance. */
  .hero__outline {
    color: transparent;
    -webkit-text-stroke: max(1.5px, 0.012em) var(--ink);
  }

  .hero__name.is-filled .hero__outline {
    -webkit-text-stroke-color: transparent;
  }

  .hero__fill {
    position: absolute;
    inset: 0;
    color: var(--accent);
    -webkit-text-stroke: max(1.5px, 0.012em) var(--accent);
    clip-path: inset(0 100% 0 0);
    pointer-events: none;
  }

  .hero__aside {
    display: flex;
    align-items: flex-end;
    gap: 1.25rem;
    padding-bottom: 0.1em;
    white-space: normal;
  }

  .hero__avatar {
    flex: 0 0 auto;
    width: clamp(64px, 0.42em, 150px);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--accent);
  }

  .hero__avatar img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    object-position: center top;
  }

  .hero__intro {
    font-family: var(--font-body);
    font-weight: 400;
    font-stretch: 100%;
    font-size: clamp(0.95rem, 1.25vw, 1.3rem);
    line-height: 1.3;
    letter-spacing: 0;
    text-transform: none;
    color: var(--ink-2);
    max-width: 30ch;
  }

  .hero__intro .serif {
    color: var(--ink);
    font-size: 1.12em;
  }

  .hero__bottom {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 1rem;
    color: var(--ink-2);
  }

  .hero__now {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    max-width: 60ch;
  }

  .hero__dot {
    flex: 0 0 auto;
    width: 7px;
    height: 7px;
    border-radius: 50%;
    background: var(--accent-2);
  }

  .hero__scroll {
    display: inline-flex;
    align-items: center;
    gap: 0.8rem;
  }

  .hero__scroll-line {
    position: relative;
    width: 64px;
    height: 1px;
    background: var(--line-strong);
    overflow: hidden;
  }

  .hero__scroll-line i {
    position: absolute;
    inset: 0;
    background: var(--accent-text);
    animation: scrollLine 2.2s var(--ease-inout) infinite;
  }

  @keyframes scrollLine {
    0% { transform: translateX(-100%); }
    50% { transform: translateX(0); }
    100% { transform: translateX(100%); }
  }

  /* Hidden until the preloader hands over (GSAP brings them in). */
  :global(html.js) .hero__fade {
    opacity: 0;
  }

  :global(html.js) .hero__name {
    visibility: hidden;
  }

  @media (prefers-reduced-motion: reduce) {
    :global(html.js) .hero__fade {
      opacity: 1;
    }
    :global(html.js) .hero__name {
      visibility: visible;
    }
    .hero__fill {
      clip-path: inset(0 0 0 0);
    }
  }

  @media (max-width: 900px) {
    .hero__top-mid {
      display: none;
    }
  }

  @media (max-width: 700px) {
    .hero {
      justify-content: flex-end;
    }
    .hero__top {
      position: absolute;
      top: calc(var(--header-h) + 1rem);
      left: var(--gutter);
      right: var(--gutter);
    }
    .hero__line--2 {
      flex-direction: column-reverse;
      align-items: flex-end;
      gap: 1.5rem;
    }
    .hero__aside {
      width: 100%;
      align-items: center;
    }
    .hero__bottom {
      flex-direction: column;
      align-items: flex-start;
    }
  }
</style>
