---
import Doodle from './Doodle.astro';
import { experience } from '../data/content';

// "May 2026 – Present" → { from: '2026', to: 'Now' }
const span = (period: string) => {
  const years = period.match(/\d{4}/g) ?? [];
  return {
    from: years[0] ?? '',
    to: /present/i.test(period) ? 'Now' : years[1] ?? '',
  };
};
---

<section class="section exp" id="experience">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-label" data-reveal>
        <span class="sec-label__idx">(03)</span>
        <span class="sec-label__rule" data-line></span>
        <span data-scramble>Experience</span>
      </div>
      <h2 class="sec-title display" data-split>
        Where I've <span class="serif">built</span>
      </h2>
      <Doodle
        before="Car"
        struck="44"
        fix="33"
        circle
        note="no clicks — just say the number, or the name."
        keyboard="all"
        pin="bottom-right"
      />
    </header>

    <ol class="exp__list">
      {
        experience.map((job, i) => {
          const { from, to } = span(job.period);
          return (
            <li class="job" data-reveal>
              <span class="rule" data-line />
              <div class="job__grid">
                <div class="job__when">
                  <span class="job__years display">
                    <span>{from}</span>
                    <span class="job__dash">—</span>
                    <span class={job.current ? 'job__to is-now' : 'job__to'}>{to}</span>
                  </span>
                  <span class="mono job__period">
                    0{i + 1} · {job.period}
                  </span>
                </div>
                <div class="job__main">
                  <div class="job__head">
                    <h3 class="job__role display">{job.role}</h3>
                    {job.current && (
                      <span class="job__live mono">
                        <i />
                        Current
                      </span>
                    )}
                  </div>
                  <p class="job__company">
                    {job.company}
                    <span class="mono job__loc">{job.location}</span>
                  </p>
                  <ul class="job__bullets">
                    {job.bullets.map((b) => (
                      <li>{b}</li>
                    ))}
                  </ul>
                </div>
              </div>
            </li>
          );
        })
      }
    </ol>
  </div>
</section>

<style>
  .exp__list {
    border-bottom: 1px solid var(--line-strong);
  }

  .job {
    position: relative;
    isolation: isolate;
  }

  .job::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--bg-elev);
    opacity: 0;
    transition: opacity 0.5s var(--ease-out);
  }

  .job:hover::before {
    opacity: 1;
  }

  .job__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(1.5rem, 5vw, 5rem);
    padding: clamp(2rem, 5vh, 3.5rem) 0;
  }

  .job__when {
    display: flex;
    flex-direction: column;
    gap: 0.8rem;
  }

  .job__years {
    display: flex;
    align-items: baseline;
    gap: 0.12em;
    font-size: clamp(3.4rem, 8.5vw, 8.5rem);
    font-weight: 900;
    font-stretch: 65%;
    color: var(--ink);
  }

  .job__dash {
    color: var(--ink-3);
    font-weight: 400;
  }

  .job__to.is-now {
    color: var(--accent-text);
  }

  .job__period {
    color: var(--ink-3);
  }

  .job__head {
    display: flex;
    align-items: flex-start;
    justify-content: space-between;
    gap: 1rem;
    margin-bottom: 0.6rem;
  }

  .job__role {
    font-size: clamp(1.8rem, 3.3vw, 3.1rem);
    line-height: 0.95;
  }

  .job__live {
    flex: 0 0 auto;
    display: inline-flex;
    align-items: center;
    gap: 0.5rem;
    padding: 0.4rem 0.75rem;
    border-radius: 999px;
    background: var(--accent-2);
    color: var(--on-accent-2);
  }

  .job__live i {
    width: 6px;
    height: 6px;
    border-radius: 50%;
    background: var(--on-accent-2);
    animation: blink 1.2s steps(2) infinite;
  }

  @keyframes blink {
    50% { opacity: 0; }
  }

  .job__company {
    display: flex;
    flex-wrap: wrap;
    align-items: baseline;
    gap: 0.4rem 1rem;
    font-size: 1.1rem;
    color: var(--ink);
    margin-bottom: 1.6rem;
  }

  .job__loc {
    color: var(--ink-3);
  }

  .job__bullets {
    display: flex;
    flex-direction: column;
    gap: 0.85rem;
    counter-reset: b;
  }

  .job__bullets li {
    position: relative;
    padding-left: 2.6rem;
    color: var(--ink-2);
    font-size: 1rem;
    line-height: 1.55;
    counter-increment: b;
  }

  .job__bullets li::before {
    content: counter(b, decimal-leading-zero);
    position: absolute;
    left: 0;
    top: 0.2em;
    font-family: var(--font-mono);
    font-size: 0.7rem;
    color: var(--accent-text);
  }

  @media (max-width: 860px) {
    .job__grid {
      grid-template-columns: 1fr;
    }
  }
</style>
