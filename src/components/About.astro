---
import { siteMeta, education, certifications, projects } from '../data/content';
import Arrow from './Arrow.astro';
import Doodle from './Doodle.astro';

// Years shipping production code, from the first full-time role.
const years = Math.max(
  1,
  Math.floor((Date.now() - new Date(siteMeta.careerStart).getTime()) / (365.25 * 864e5))
);
const mcaGrade = education[0]?.grade.match(/[\d.]+/)?.[0] ?? '9.2';

const stats = [
  { value: years, decimals: 0, suffix: '+', label: 'Years shipping production software' },
  { value: Number(mcaGrade), decimals: 1, suffix: '', label: 'CGPA — Master of Computer Applications' },
  { value: projects.length, decimals: 0, suffix: '+', label: 'Featured products shipped' },
  { value: certifications.length, decimals: 0, suffix: '', label: 'Verified certifications' },
];
---

<section class="section about" id="about">
  <div class="wrap">
    <div class="sec-label" data-reveal>
      <span class="sec-label__idx">(01)</span>
      <span class="sec-label__rule" data-line></span>
      <span data-scramble>About me</span>
    </div>

    <Doodle
      before="Knock"
      struck="once"
      fix="five times"
      note="on the badge up top — then wait for the dark."
      arrow="up-left"
      pin="top-right"
    />

    <p class="about__statement" data-words>
      I'm {siteMeta.name.split(' ')[0]} — a software engineer who builds
      <em class="serif">scalable</em>, <em class="serif">dependable</em> systems end-to-end.
      Today I work in R&amp;D at Meril (Nuvo AI) out of IIT Kanpur Technopark, wiring custom
      fine-tuned AI models into medical and regulatory workflows that thousands of people can
      rely on.
    </p>

    <div class="about__grid">
      <figure class="about__portrait" data-clip>
        <img
          src="/assets/contact-avatar.png"
          alt="Illustrated Shreyas Misra pointing at himself"
          width="640"
          height="1280"
          loading="lazy"
          decoding="async"
          data-speed="0.85"
        />
        <figcaption class="mono about__caption">
          <span>{siteMeta.name}</span>
          <span>{siteMeta.role}</span>
        </figcaption>
      </figure>

      <div class="about__body">
        <blockquote class="about__quote" data-reveal>
          <span class="mono about__quote-cap">Objective</span>
          <p class="serif">&ldquo;{siteMeta.objective}&rdquo;</p>
        </blockquote>

        <ul class="about__stats">
          {
            stats.map((s) => (
              <li class="about__stat" data-reveal>
                <span class="rule" data-line />
                <span class="about__stat-num display">
                  <span data-count={s.value} data-decimals={s.decimals}>{s.value.toFixed(s.decimals)}</span><span class="about__stat-suffix">{s.suffix}</span>
                </span>
                <span class="mono about__stat-label">{s.label}</span>
              </li>
            ))
          }
        </ul>

        <div class="about__ctas" data-reveal>
          <a
            class="pill pill--solid magnetic"
            href="/Resume.pdf"
            target="_blank"
            rel="noopener noreferrer"
            data-cursor="Open ↗"
          >
            <span class="roll"><span data-text="Download résumé">Download résumé</span></span>
            <span class="pill__arrow" aria-hidden="true"><Arrow /></span>
          </a>
          <a class="pill magnetic" href="#contact" data-nav="contact">
            <span class="roll"><span data-text="Get in touch">Get in touch</span></span>
            <span class="pill__arrow" aria-hidden="true"><Arrow dir="right" /></span>
          </a>
        </div>

        <Doodle
          class="about__doodle"
          struck="Tyre"
          fix="code"
          after="whisperer"
          note="three letters call me in for fresh ones."
          arrow="under"
          keyboard="note"
        />
      </div>
    </div>

    <div class="edu">
      <div class="edu__head">
        <span class="mono edu__cap" data-reveal>Education</span>
      </div>
      <ol class="edu__list">
        {
          education.map((ed, i) => (
            <li class="edu__row" data-reveal>
              <span class="rule" data-line />
              <div class="edu__grid">
                <span class="mono edu__idx">0{i + 1}</span>
                <h3 class="edu__degree display">{ed.degree}</h3>
                <div class="edu__meta">
                  <span class="edu__inst">{ed.institution}</span>
                  <span class="mono edu__period">{ed.period}</span>
                </div>
                <div class="edu__side">
                  <span class="edu__grade display">{ed.grade}</span>
                  <span class="edu__course">{ed.coursework}</span>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
    </div>
  </div>
</section>

<style>
  .about > .wrap {
    position: relative;
  }

  .about__doodle {
    margin-top: 3.5rem;
  }

  .about__statement {
    margin: clamp(2.5rem, 7vh, 5rem) 0 clamp(4rem, 10vh, 7rem);
    font-family: var(--font-display);
    font-weight: 600;
    font-stretch: 85%;
    font-size: clamp(1.8rem, 4.3vw, 4.4rem);
    line-height: 1.04;
    letter-spacing: -0.02em;
    color: var(--ink);
  }

  .about__statement .serif {
    color: var(--accent-text);
    font-size: 1.08em;
  }

  .about__grid {
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    align-items: start;
  }

  .about__portrait {
    position: relative;
    aspect-ratio: 4 / 5;
    border-radius: var(--radius);
    overflow: hidden;
    background:
      radial-gradient(circle at 50% 30%, rgba(255, 255, 255, 0.18), transparent 60%),
      var(--accent);
  }

  .about__portrait img {
    position: absolute;
    left: 0;
    top: -2%;
    width: 100%;
    height: 112%;
    object-fit: cover;
    object-position: center top;
  }

  .about__caption {
    position: absolute;
    left: 1rem;
    right: 1rem;
    bottom: 1rem;
    display: flex;
    justify-content: space-between;
    color: var(--on-accent);
    font-size: 0.66rem;
  }

  .about__quote {
    margin-bottom: 3rem;
  }

  .about__quote-cap {
    display: block;
    color: var(--ink-3);
    margin-bottom: 0.9rem;
  }

  .about__quote p {
    font-size: clamp(1.5rem, 2.6vw, 2.4rem);
    line-height: 1.12;
    color: var(--ink);
  }

  .about__stats {
    display: grid;
    grid-template-columns: repeat(2, minmax(0, 1fr));
    gap: 2.5rem 2rem;
    margin-bottom: 3rem;
  }

  .about__stat {
    display: flex;
    flex-direction: column;
    gap: 0.9rem;
  }

  .about__stat-num {
    font-size: clamp(3.5rem, 7vw, 6.5rem);
    color: var(--ink);
    font-variant-numeric: tabular-nums;
  }

  .about__stat-suffix {
    color: var(--accent-text);
  }

  .about__stat-label {
    color: var(--ink-2);
    max-width: 24ch;
  }

  .about__ctas {
    display: flex;
    flex-wrap: wrap;
    gap: 0.8rem;
  }

  /* ----- Education ----- */
  .edu {
    margin-top: clamp(5rem, 14vh, 9rem);
  }

  .edu__cap {
    display: block;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
  }

  .edu__row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .edu__grid {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 2rem 0;
  }

  .edu__idx {
    color: var(--accent-text);
  }

  .edu__degree {
    font-size: clamp(1.6rem, 3vw, 2.8rem);
  }

  .edu__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .edu__inst {
    font-size: 1.05rem;
    color: var(--ink);
  }

  .edu__period {
    color: var(--ink-3);
  }

  .edu__side {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .edu__grade {
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    color: var(--accent-text);
  }

  .edu__course {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .about__grid {
      grid-template-columns: 1fr;
    }
    .about__portrait {
      max-width: 420px;
    }
    .edu__grid {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .edu__meta,
    .edu__side {
      grid-column: 2;
    }
  }

  @media (max-width: 520px) {
    .about__stats {
      gap: 2rem 1.25rem;
    }
  }
</style>
