---
// Education: its own section, after Skills and before Certifications.
import { education } from '../data/content';

// "9.2 CGPA (3.65 GPA)" → mark the converted GPA with a footnote asterisk.
const gradeParts = (grade: string) => {
  const m = grade.match(/^(.*\(.*?GPA)(\).*)$/);
  return m ? [{ text: m[1], note: true }, { text: m[2], note: false }] : [{ text: grade, note: false }];
};
---

<section class="section edu-sec" id="education">
  <div class="wrap">
    <div class="edu">
      <div class="sec-label edu__label" data-reveal>
        <span class="sec-label__idx">(04)</span>
        <span class="sec-label__rule" data-line></span>
        <span data-scramble>Education</span>
      </div>
      <ol class="edu__list">
        {
          education.map((ed, i) => (
            <li class="edu__row" data-reveal>
              <span class="rule" data-line />
              <div class="edu__grid">
                <span class="mono edu__idx">0{i + 1}</span>
                <h3 class="edu__degree display">{ed.degree}</h3>
                <div class="edu__meta">
                  <span class="edu__inst">{ed.institution}</span>
                  <span class="mono edu__period">{ed.period}</span>
                </div>
                <div class="edu__side">
                  <span class="edu__grade display">{gradeParts(ed.grade).map((g) => g.note ? <>{g.text}<span class="edu__ast" aria-hidden="true">*</span></> : g.text)}</span>
                  <span class="edu__course">{ed.coursework}</span>
                </div>
              </div>
            </li>
          ))
        }
      </ol>
      {
        education.some((ed) => /GPA/.test(ed.grade)) && (
          <p class="edu__note mono">
            <span aria-hidden="true">*</span> GPA figures are approximate: there's no single standard for converting
            Indian grades to a 4.0 scale.
          </p>
        )
      }
    </div>
  </div>
</section>

<style>
  .edu__label {
    margin-bottom: clamp(2.5rem, 6vh, 4rem);
  }

  .edu__row:last-child {
    border-bottom: 1px solid var(--line-strong);
  }

  .edu__grid {
    display: grid;
    grid-template-columns: 3rem minmax(0, 1.3fr) minmax(0, 1fr) minmax(0, 1.1fr);
    gap: 1.5rem;
    align-items: baseline;
    padding: 2rem 0;
  }

  .edu__idx {
    color: var(--accent-text);
  }

  .edu__degree {
    font-size: clamp(1.6rem, 3vw, 2.8rem);
  }

  .edu__meta {
    display: flex;
    flex-direction: column;
    gap: 0.3rem;
  }

  .edu__inst {
    font-size: 1.05rem;
    color: var(--ink);
  }

  .edu__period {
    color: var(--ink-3);
  }

  .edu__side {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .edu__grade {
    font-size: clamp(1.2rem, 1.8vw, 1.6rem);
    color: var(--accent-text);
  }

  .edu__ast {
    font-size: 0.55em;
    vertical-align: 0.6em;
    margin-left: 0.05em;
  }

  .edu__note {
    margin-top: 1rem;
    font-size: 0.68rem;
    line-height: 1.5;
    letter-spacing: 0.01em;
    text-transform: none;
    color: var(--ink-3);
  }

  .edu__course {
    font-size: 0.9rem;
    color: var(--ink-2);
  }

  @media (max-width: 900px) {
    .edu__grid {
      grid-template-columns: 2.5rem minmax(0, 1fr);
    }
    .edu__meta,
    .edu__side {
      grid-column: 2;
    }
  }
</style>
