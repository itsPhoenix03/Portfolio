---
import { siteMeta, socialLinks, navSections, contactForm } from '../data/content';
import Arrow from './Arrow.astro';
import { STAR_PATH } from '../scripts/icons';

const year = new Date().getFullYear();

// "Say hello" ring: four phrases around the circle with a star between each.
// The path starts at the left (t = 0) and runs clockwise; phrases are centred
// on each quarter and stars sit on the quarter boundaries, just outside the
// path so they line up with the middle of the text.
const ringPhrases = ['Say hello', "Let's talk", 'Say hello', "Let's talk"];
const ringStars = [0, 0.25, 0.5, 0.75].map((t) => {
  const a = Math.PI + t * Math.PI * 2;
  const r = 85;
  return {
    x: +(100 + r * Math.cos(a)).toFixed(2),
    y: +(100 + r * Math.sin(a)).toFixed(2),
    rot: +((a * 180) / Math.PI + 90).toFixed(1),
  };
});
const links = [
  ...socialLinks.filter((s) => s.href.startsWith('http')),
  { label: 'Résumé', href: '/Resume.pdf', icon: '' },
];
---

<section class="section contact" id="contact">
  <div class="wrap">
    <div class="sec-label" data-reveal>
      <span class="sec-label__idx">(06)</span>
      <span class="sec-label__rule" data-line></span>
      <span data-scramble>Contact</span>
    </div>

    <div class="contact__hero">
      <h2 class="contact__title display" data-split>
        Let's build<br />something <span class="serif">dependable</span>
      </h2>

      <div class="contact__wave">
        <div class="contact__wave-frame">
          <img
            src="/assets/avatar-wave.png"
            alt="Illustrated Shreyas Misra waving hello"
            width="640"
            height="1280"
            loading="lazy"
            decoding="async"
          />
        </div>
        <a
        class="contact__orb magnetic"
        href={`mailto:${siteMeta.email}`}
        data-cursor="Email ↗"
        aria-label={`Email ${siteMeta.name}`}
      >
        <svg class="contact__orb-ring" viewBox="0 0 200 200" aria-hidden="true">
          <defs>
            <path id="orb-circle" d="M100,100 m-80,0 a80,80 0 1,1 160,0 a80,80 0 1,1 -160,0"></path>
          </defs>
          {
            ringPhrases.map((phrase, i) => (
              <text text-anchor="middle" textLength="100" lengthAdjust="spacing">
                <textPath href="#orb-circle" startOffset={`${12.5 + i * 25}%`}>{phrase}</textPath>
              </text>
            ))
          }
          {
            ringStars.map((s) => (
              <path
                class="contact__orb-star"
                d={STAR_PATH}
                transform={`translate(${s.x} ${s.y}) rotate(${s.rot}) scale(0.4) translate(-12 -12)`}
              />
            ))
          }
        </svg>
        <span class="contact__orb-arrow" aria-hidden="true"><Arrow /></span>
        </a>
      </div>
    </div>

    <div class="contact__grid">
      <div class="contact__info" data-reveal>
        <span class="mono contact__cap">Drop a line</span>
        <a class="contact__mail" href={`mailto:${siteMeta.email}`} data-cursor="Email ↗">
          {siteMeta.email}
        </a>
        <p class="contact__sub">
          Open to new roles, freelance builds and collaborations — especially anything where
          reliability and scale actually matter.
        </p>
      </div>

      <form
        class="contact__form"
        action={contactForm.endpoint}
        method="POST"
        data-reveal
        id="contact-form"
      >
        <input type="hidden" name="access_key" value={contactForm.accessKey} />
        <input type="hidden" name="subject" value="New message from your portfolio" />
        <input type="hidden" name="from_name" value={`${siteMeta.name} — Portfolio`} />
        <!-- Honeypot: bots tick it, humans never see it; Web3Forms drops those. -->
        <input type="checkbox" name="botcheck" class="contact__hp" tabindex="-1" autocomplete="off" />
        <div class="contact__row">
          <div class="contact__field">
            <input type="text" name="name" id="cf-name" required placeholder=" " autocomplete="name" />
            <label for="cf-name">Your name</label>
          </div>
          <div class="contact__field">
            <input type="email" name="email" id="cf-email" required placeholder=" " autocomplete="email" />
            <label for="cf-email">Email</label>
          </div>
        </div>
        <div class="contact__field">
          <textarea name="message" id="cf-message" rows="4" required placeholder=" "></textarea>
          <label for="cf-message">Tell me about your project</label>
        </div>
        <div class="contact__submit-row">
          <button type="submit" class="pill pill--solid contact__submit magnetic" data-cursor="Send ↗">
            <span class="roll"><span data-text="Send message">Send message</span></span>
            <span class="pill__arrow" aria-hidden="true"><Arrow /></span>
          </button>
          <p class="contact__status mono" id="cf-status" role="status" aria-live="polite"></p>
        </div>
      </form>
    </div>

    <footer class="footer">
      <div class="footer__cols">
        <div class="footer__col">
          <span class="mono footer__cap">Elsewhere</span>
          <ul>
            {
              links.map((l) => (
                <li>
                  <a href={l.href} target="_blank" rel="noopener noreferrer">
                    <span class="roll">
                      <span data-text={l.label}>{l.label}</span>
                    </span>{' '}
                    <Arrow />
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer__col">
          <span class="mono footer__cap">Index</span>
          <ul>
            {
              navSections.slice(1).map((s) => (
                <li>
                  <a href={`#${s.id}`} data-nav={s.id}>
                    <span class="roll">
                      <span data-text={s.label}>{s.label}</span>
                    </span>
                  </a>
                </li>
              ))
            }
          </ul>
        </div>
        <div class="footer__col">
          <span class="mono footer__cap">Local time</span>
          <span class="footer__time display"><span data-clock>--:--:--</span></span>
          <span class="mono footer__muted">{siteMeta.location} · IST</span>
        </div>
        <div class="footer__col footer__col--end">
          <a href="#hero" data-nav="hero" class="pill magnetic" data-cursor="Top ↑">
            <span class="roll"><span data-text="Back to top">Back to top</span></span>
            <span aria-hidden="true"><Arrow dir="up" /></span>
          </a>
        </div>
      </div>

      <div class="footer__name display" id="footer-name" aria-hidden="true">
        <span class="footer__name-text">Shreyas Misra</span>
      </div>

      <div class="footer__base mono">
        <span>© {year} {siteMeta.name}</span>
        <button type="button" class="footer__radio" id="footer-radio" aria-label="Next quote"></button>
        <span>Built with Astro · Three.js · GSAP</span>
      </div>
    </footer>
  </div>
</section>

<style>
  .contact {
    padding-bottom: 0;
  }

  .contact__hero {
    display: flex;
    justify-content: space-between;
    align-items: flex-end;
    gap: 2rem;
    margin: clamp(2.5rem, 7vh, 5rem) 0 clamp(3rem, 9vh, 6rem);
  }

  .contact__title {
    font-size: clamp(3.4rem, 10.5vw, 11rem);
  }

  .contact__title .serif {
    color: var(--accent-text);
  }

  /* Waving avatar rising from the divider, with the orb as a speech bubble. */
  .contact__wave {
    position: relative;
    flex: 0 0 auto;
    align-self: flex-end;
    width: clamp(200px, 22vw, 320px);
    margin-bottom: calc(-1 * clamp(3rem, 9vh, 6rem));
  }

  .contact__wave-frame {
    position: relative;
    aspect-ratio: 1 / 1.15;
    overflow: hidden;
  }

  .contact__wave-frame img {
    position: absolute;
    left: 0;
    top: 0;
    width: 100%;
    height: auto;
    transform-origin: 50% 100%;
    transition: transform 0.6s var(--ease-out);
  }

  .contact__wave:hover .contact__wave-frame img {
    transform: rotate(-3deg) translateY(-2%);
  }

  .contact__wave .contact__orb {
    position: absolute;
    top: -8%;
    left: -42%;
  }

  /* Rotating "Say hello" badge. */
  .contact__orb {
    position: relative;
    flex: 0 0 auto;
    width: clamp(140px, 15vw, 220px);
    aspect-ratio: 1;
    display: grid;
    place-items: center;
    border-radius: 50%;
    background: var(--accent);
    color: var(--on-accent);
    transition: background 0.5s var(--ease-out), color 0.5s var(--ease-out);
  }

  .contact__orb:hover {
    background: var(--ink);
    color: var(--bg);
  }

  .contact__orb-ring {
    position: absolute;
    inset: 6%;
    width: 88%;
    height: 88%;
    animation: orbSpin 14s linear infinite;
  }

  .contact__orb-star {
    fill: currentColor;
  }

  .contact__orb-ring text {
    fill: currentColor;
    font-family: var(--font-mono);
    font-size: 14.2px;
    letter-spacing: 0.12em;
    text-transform: uppercase;
  }

  .contact__orb-arrow {
    font-size: clamp(2.2rem, 3.4vw, 3.4rem);
    line-height: 1;
    transition: transform 0.6s var(--ease-out);
  }

  .contact__orb:hover .contact__orb-arrow {
    transform: rotate(45deg);
  }

  @keyframes orbSpin {
    to { transform: rotate(360deg); }
  }

  .contact__grid {
    position: relative;
    z-index: 1;
    background: var(--veil);
    display: grid;
    grid-template-columns: minmax(0, 5fr) minmax(0, 7fr);
    gap: clamp(2rem, 6vw, 6rem);
    padding-top: clamp(2rem, 5vh, 3rem);
    border-top: 1px solid var(--line-strong);
  }

  .contact__cap {
    display: block;
    color: var(--ink-3);
    margin-bottom: 1rem;
  }

  .contact__mail {
    display: inline-block;
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 80%;
    font-size: clamp(1.4rem, 2.7vw, 2.6rem);
    line-height: 1.1;
    word-break: break-all;
    background: linear-gradient(var(--accent-text), var(--accent-text)) left bottom / 0 2px no-repeat;
    padding-bottom: 0.2rem;
    transition: background-size 0.6s var(--ease-out), color 0.4s ease;
  }

  .contact__mail:hover {
    background-size: 100% 2px;
    color: var(--accent-text);
  }

  .contact__sub {
    margin-top: 1.5rem;
    max-width: 38ch;
  }

  /* ----- Form ----- */
  .contact__form {
    display: flex;
    flex-direction: column;
    gap: 1.6rem;
  }

  .contact__row {
    display: grid;
    grid-template-columns: 1fr 1fr;
    gap: 1.6rem;
  }

  .contact__hp {
    position: absolute;
    left: -9999px;
  }

  .contact__field {
    position: relative;
  }

  .contact__field input,
  .contact__field textarea {
    width: 100%;
    background: transparent;
    border: none;
    border-bottom: 1px solid var(--line-strong);
    padding: 1.6rem 0 0.7rem;
    color: var(--ink);
    font-family: var(--font-body);
    font-size: 1.15rem;
    resize: vertical;
    border-radius: 0;
    transition: border-color 0.3s ease;
  }

  .contact__field textarea {
    min-height: 120px;
  }

  .contact__field input:focus,
  .contact__field textarea:focus {
    outline: none;
    border-color: var(--accent-text);
  }

  .contact__field label {
    position: absolute;
    top: 1.6rem;
    left: 0;
    font-family: var(--font-mono);
    font-size: 0.8rem;
    text-transform: uppercase;
    letter-spacing: 0.06em;
    color: var(--ink-3);
    pointer-events: none;
    transform-origin: left top;
    transition: transform 0.35s var(--ease-out), color 0.3s ease;
  }

  .contact__field input:focus + label,
  .contact__field input:not(:placeholder-shown) + label,
  .contact__field textarea:focus + label,
  .contact__field textarea:not(:placeholder-shown) + label {
    transform: translateY(-1.35rem) scale(0.82);
    color: var(--accent-text);
  }

  .contact__submit-row {
    display: flex;
    align-items: center;
    flex-wrap: wrap;
    gap: 1rem 1.5rem;
  }

  .contact__submit:disabled {
    opacity: 0.6;
    cursor: progress;
  }

  .contact__status {
    color: var(--ink-2);
  }

  .contact__status.is-ok {
    color: var(--success);
  }

  .contact__status.is-err {
    color: var(--danger);
  }

  /* ----- Footer ----- */
  .footer {
    margin-top: clamp(5rem, 14vh, 9rem);
    border-top: 1px solid var(--line-strong);
    padding-top: 2.5rem;
  }

  .footer__cols {
    display: grid;
    grid-template-columns: repeat(4, minmax(0, 1fr));
    gap: 2rem;
  }

  .footer__col {
    display: flex;
    flex-direction: column;
    gap: 0.4rem;
  }

  .footer__col ul {
    display: flex;
    flex-direction: column;
    gap: 0.35rem;
    font-size: 1.05rem;
  }

  .footer__col a:hover {
    color: var(--accent-text);
  }

  .footer__col--end {
    align-items: flex-end;
    justify-content: flex-start;
  }

  .footer__cap {
    color: var(--ink-3);
    margin-bottom: 0.6rem;
  }

  .footer__time {
    font-size: clamp(2rem, 3.4vw, 3.2rem);
    font-variant-numeric: tabular-nums;
  }

  .footer__muted {
    color: var(--ink-3);
  }

  .footer__name {
    margin-top: clamp(3rem, 8vh, 6rem);
    font-size: var(--fit, 13vw);
    font-weight: 900;
    font-stretch: 68%;
    line-height: 0.78;
    letter-spacing: -0.02em;
    white-space: nowrap;
    color: var(--ink);
    overflow: hidden;
    padding-top: 0.04em;
  }

  .footer__name-text {
    display: inline-block;
  }

  .footer__base {
    display: flex;
    justify-content: space-between;
    flex-wrap: wrap;
    gap: 0.5rem 1rem;
    padding: 1.4rem 0 1.6rem;
    color: var(--ink-3);
  }

  .footer__radio {
    font-family: var(--font-serif);
    font-style: italic;
    font-size: 0.95rem;
    text-transform: none;
    letter-spacing: 0;
    color: var(--ink-3);
    text-align: center;
    max-width: 52ch;
    transition: color 0.3s ease;
  }

  .footer__radio:hover {
    color: var(--accent-text);
  }

  @media (max-width: 900px) {
    .footer__radio {
      order: 3;
      text-align: left;
    }
  }

  @media (max-width: 900px) {
    .contact__hero {
      flex-direction: column;
      align-items: flex-start;
    }
    .contact__wave {
      align-self: flex-end;
      width: clamp(170px, 46vw, 240px);
      margin-right: 1rem;
    }
    .contact__wave .contact__orb {
      left: -55%;
      width: clamp(110px, 30vw, 150px);
    }
    .contact__grid {
      grid-template-columns: 1fr;
    }
    .footer__cols {
      grid-template-columns: repeat(2, minmax(0, 1fr));
    }
    .footer__col--end {
      align-items: flex-start;
    }
  }

  @media (max-width: 520px) {
    .contact__row {
      grid-template-columns: 1fr;
    }
  }
</style>

<script>
  import { checkSvg, closeSvg } from '@/scripts/icons';
  import { duckMusic } from '@/scripts/duck';

  const form = document.getElementById('contact-form') as HTMLFormElement | null;
  const status = document.getElementById('cf-status');

  if (form) {
    // Quieter while someone is writing.
    form.addEventListener('focusin', () => duckMusic('form', 0.45));
    form.addEventListener('focusout', (e) => {
      if (!form.contains((e as FocusEvent).relatedTarget as Node)) duckMusic('form', null);
    });
  }

  if (form && status) {
    const fallback = form.querySelector<HTMLInputElement>('[name="subject"]')?.value ?? '';
    const email = document.querySelector<HTMLAnchorElement>('.contact__mail')?.textContent?.trim();

    form.addEventListener('submit', async (e) => {
      e.preventDefault();
      const btn = form.querySelector<HTMLButtonElement>('.contact__submit');
      status.className = 'contact__status mono';
      status.textContent = 'Sending…';
      if (btn) btn.disabled = true;

      const data = Object.fromEntries(new FormData(form)) as Record<string, string>;
      if (data.name) data.subject = `Portfolio — new message from ${data.name}`;
      else data.subject = fallback;

      try {
        const res = await fetch(form.action, {
          method: 'POST',
          headers: { 'Content-Type': 'application/json', Accept: 'application/json' },
          body: JSON.stringify(data),
        });
        const json = await res.json().catch(() => ({}));
        // Only report success when Web3Forms actually accepted the message.
        if (!res.ok || !json.success) throw new Error(json.message || `HTTP ${res.status}`);

        status.textContent = ' Message sent — I’ll get back to you soon.';
        status.insertAdjacentHTML('afterbegin', checkSvg());
        status.classList.add('is-ok');
        form.reset();
        // Team-radio toast (EasterEggs.astro listens for this).
        window.dispatchEvent(
          new CustomEvent('team-radio', {
            detail: { quote: { text: 'Simply lovely.', by: 'Max Verstappen' }, cap: 'Message received' },
          })
        );
      } catch {
        status.textContent = ` Couldn’t send that — please email me${email ? ` at ${email}` : ''} instead.`;
        status.insertAdjacentHTML('afterbegin', closeSvg());
        status.classList.add('is-err');
      } finally {
        if (btn) btn.disabled = false;
      }
    });
  }
</script>
