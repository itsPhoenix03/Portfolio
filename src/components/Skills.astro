---
import { skillGroups } from '../data/content';
import Marquee from './Marquee.astro';
---

<section class="section skills" id="skills">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-label" data-reveal>
        <span class="sec-label__idx">(02)</span>
        <span class="sec-label__rule" data-line></span>
        <span data-scramble>Skills &amp; stack</span>
      </div>
      <h2 class="sec-title display" data-split>
        Tools of the <span class="serif">trade</span>
      </h2>
    </header>
  </div>

  <ul class="skills__rows">
    {
      skillGroups.map((group, i) => (
        <li class="skills__row" data-reveal>
          <div class="skills__meta wrap mono">
            <span class="skills__idx">0{i + 1}</span>
            <span class="skills__cat">{group.category}</span>
            <span class="skills__count">{String(group.items.length).padStart(2, '0')} items</span>
          </div>
          <Marquee
            class="skills__marquee"
            items={group.items.map((s) => s.name)}
            direction={i % 2 === 0 ? -1 : 1}
            speed={24 + group.items.length * 3}
            separator="/"
          />
          <p class="sr-only">
            {group.category}: {group.items.map((s) => s.name).join(', ')}
          </p>
        </li>
      ))
    }
  </ul>
</section>

<style>
  .skills {
    padding-left: 0;
    padding-right: 0;
  }

  .skills > .wrap {
    padding: 0 var(--gutter);
  }

  .skills__rows {
    border-top: 1px solid var(--line-strong);
  }

  .skills__row {
    position: relative;
    padding: 1.4rem 0 1.1rem;
    border-bottom: 1px solid var(--line-strong);
    overflow: hidden;
    transition: color 0.5s var(--ease-out);
  }

  /* Accent fill wipes up behind the row on hover. */
  .skills__row::before {
    content: '';
    position: absolute;
    inset: 0;
    background: var(--accent);
    transform: scaleY(0);
    transform-origin: bottom center;
    transition: transform 0.6s var(--ease-out);
  }

  .skills__row:hover {
    color: var(--on-accent);
  }

  .skills__row:hover::before {
    transform: scaleY(1);
  }

  .skills__meta {
    position: relative;
    display: grid;
    grid-template-columns: 3rem 1fr auto;
    gap: 1rem;
    padding: 0 var(--gutter);
    margin-bottom: 0.6rem;
    color: var(--ink-2);
    transition: color 0.5s var(--ease-out);
  }

  .skills__row:hover .skills__meta {
    color: var(--on-accent);
  }

  .skills__idx {
    color: var(--accent-text);
  }

  .skills__row:hover .skills__idx {
    color: var(--on-accent);
  }

  .skills__row :global(.skills__marquee) {
    position: relative;
    font-size: clamp(2.6rem, 7.5vw, 7.5rem);
  }

  .skills__row :global(.skills__marquee .marquee__sep) {
    color: var(--accent-text);
    font-size: 0.6em;
    font-family: var(--font-serif);
    font-style: italic;
  }

  .skills__row:hover :global(.skills__marquee .marquee__sep) {
    color: var(--on-accent);
  }
</style>
