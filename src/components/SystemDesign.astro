---
// System design section. With motion on, it grows out of the "Backend &
// Databases" skills strip into a full-screen red panel. Scrolling then moves
// the view along a hidden wave across a big surface: big stops are general
// "this or that" questions laid out as trade-offs (where each option shines,
// what it costs, what the call hinges on), and between them smaller notes show
// which way one real system went. Hand-drawn sketches sit around the route.
// At the end it shrinks back into the strip. Without motion (or JS) it's a
// plain section, everything stacked.
import { systemDesign } from '../data/content';
import { WAVE_POINTS, WAVE_SIZE, wavePath } from '../scripts/wave';
import { doodles, doodleArt } from '../scripts/sd-doodles';

const { label, intro, outro, stops, notes } = systemDesign;
const pad = (n: number) => String(n).padStart(2, '0');

// "*word*" → italic serif.
const parts = (title: string) =>
  title.split('*').map((text, i) => ({ text, em: i % 2 === 1 }));

// Walk the route and hand out content in travel order: big stops to 'stop'
// points, practice notes to 'note' points.
let si = 0;
let ni = 0;
const route = WAVE_POINTS.map((pt) =>
  pt.kind === 'stop'
    ? { ...pt, kind: 'stop' as const, n: si, stop: stops[si++] }
    : { ...pt, kind: 'note' as const, n: ni, note: notes[ni++] }
);
const bigStops = route.filter((r) => r.kind === 'stop');

// Track map: the same wave, scaled into a small SVG.
const MAP_SCALE = 100;
const mapW = WAVE_SIZE[0] * MAP_SCALE;
const mapH = WAVE_SIZE[1] * MAP_SCALE;
const mapD = wavePath(MAP_SCALE, MAP_SCALE);
---

<section class="sd" id="system-design" aria-labelledby="sd-title" data-sd>
  <h2 class="sr-only" id="sd-title">{label}</h2>

  <div class="sd__grid" aria-hidden="true"></div>

  <p class="sd__band sd__band--in display" aria-hidden="true">{intro}</p>
  <p class="sd__band sd__band--out display" aria-hidden="true">{outro}</p>

  <div class="sd__deco" aria-hidden="true">
    {
      bigStops.map((r) => (
        <span class="sd__num display" data-x={r.at[0]} data-y={r.at[1]}>
          {pad(r.n + 1)}
        </span>
      ))
    }
  </div>

  <div class="sd__canvas">
    {
      doodles.map((d) => {
        const a = doodleArt(d.art);
        return (
          <svg
            class="sd__dd"
            viewBox={`0 0 ${a.w} ${a.h}`}
            data-x={d.at[0]}
            data-y={d.at[1]}
            style={`--w:${d.w};rotate:${d.rot}deg`}
            aria-hidden="true"
            set:html={a.body}
          />
        );
      })
    }
    {
      route.map((r) =>
        r.kind === 'stop' ? (
          <article class="sd__stop" data-x={r.at[0]} data-y={r.at[1]} data-kind="stop">
            <span class="sd__kicker mono">{pad(r.n + 1)} — It depends</span>
            <h3 class="sd__title display">
              {parts(r.stop.title).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}
            </h3>
            <div class="sd__opts" style={`--cols:${r.stop.options.length}`}>
              {r.stop.options.map((o) => (
                <div class="sd__opt">
                  <h4 class="sd__opt-name display">{o.name}</h4>
                  <p class="sd__opt-row">
                    <span class="mono">Shines</span>
                    {o.shines}
                  </p>
                  <p class="sd__opt-row sd__opt-row--cost">
                    <span class="mono">Costs</span>
                    {o.costs}
                  </p>
                </div>
              ))}
            </div>
            <p class="sd__hinge">
              <span class="mono">Hinges on</span>
              {r.stop.hinge}
            </p>
          </article>
        ) : (
          <p class="sd__note" data-x={r.at[0]} data-y={r.at[1]} data-kind="note">
            <span class="sd__note-kicker mono">
              <i />In practice
            </span>
            <span class="sd__note-text">
              {parts(r.note.text).map((p) => (p.em ? <em class="serif">{p.text}</em> : p.text))}
            </span>
          </p>
        )
      )
    }
  </div>

  <div class="sd__hud mono" aria-hidden="true">
    <div class="sd__map">
      <svg viewBox={`-20 -20 ${mapW + 40} ${mapH + 40}`}>
        <path class="sd__map-path" d={mapD} />
        {
          WAVE_POINTS.map(({ at: [x, y], kind }) => (
            <circle
              class={kind === 'stop' ? 'sd__map-stop' : 'sd__map-note'}
              cx={x * MAP_SCALE}
              cy={y * MAP_SCALE}
              r={kind === 'stop' ? 11 : 6}
            />
          ))
        }
        <circle class="sd__map-car" id="sd-car" cx={WAVE_POINTS[0].at[0] * MAP_SCALE} cy={WAVE_POINTS[0].at[1] * MAP_SCALE} r="18" />
      </svg>
    </div>
    <span class="sd__hud-label">{label}</span>
    <span class="sd__count"><span id="sd-count">01</span> / {pad(stops.length)}</span>
  </div>
</section>

<style>
  .sd {
    position: relative;
    background: var(--accent);
    color: var(--on-accent);
    padding: clamp(4rem, 10vh, 7rem) var(--gutter);
    overflow: hidden;
  }

  .sd__grid {
    position: absolute;
    inset: 0;
    background-image: radial-gradient(rgba(255, 255, 255, 0.22) 1px, transparent 1.6px);
    background-size: 30px 30px;
    pointer-events: none;
  }

  /* ----- Stops ----- */
  .sd__canvas {
    position: relative;
    display: grid;
    gap: clamp(3.5rem, 9vh, 6rem);
  }

  .sd__stop {
    width: min(64rem, 100%);
  }

  .sd__kicker {
    display: block;
    margin-bottom: 1.1rem;
    color: var(--accent-2);
    font-size: 0.72rem;
  }

  .sd__title {
    font-size: clamp(2.3rem, 5vw, 5.4rem);
    line-height: 0.92;
    color: #fff;
  }

  .sd__title .serif {
    color: var(--accent-2);
    font-size: 1.06em;
    padding-right: 0.05em;
  }

  /* Options side by side: where each one shines, and what it costs. */
  .sd__opts {
    display: grid;
    grid-template-columns: repeat(var(--cols), minmax(0, 1fr));
    gap: clamp(1.2rem, 2.5vw, 2.5rem);
    margin-top: clamp(1.4rem, 3vh, 2.2rem);
  }

  .sd__opt {
    padding-top: 0.9rem;
    border-top: 1px solid rgba(255, 255, 255, 0.4);
  }

  .sd__opt-name {
    font-size: clamp(1.3rem, 2vw, 1.9rem);
    line-height: 1;
    color: var(--accent-2);
  }

  .sd__opt-row {
    margin-top: 0.7rem;
    font-size: clamp(0.88rem, 1.05vw, 1.02rem);
    line-height: 1.45;
    color: rgba(255, 255, 255, 0.92);
  }

  .sd__opt-row--cost {
    color: rgba(255, 255, 255, 0.72);
  }

  .sd__opt-row .mono,
  .sd__hinge .mono {
    display: block;
    margin-bottom: 0.2rem;
    font-size: 0.62rem;
    color: rgba(255, 255, 255, 0.6);
  }

  .sd__hinge {
    margin-top: clamp(1.2rem, 2.6vh, 1.8rem);
    font-family: var(--font-serif);
    font-style: italic;
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    line-height: 1.2;
    color: #fff;
  }

  /* Practice notes: plain text on the route, smaller than the stops. */
  .sd__note {
    display: grid;
    gap: 0.75rem;
    width: min(25rem, 100%);
  }

  .sd__note-kicker {
    display: inline-flex;
    align-items: center;
    gap: 0.6rem;
    font-size: 0.66rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .sd__note-kicker i {
    width: 1.6rem;
    height: 2px;
    background: var(--accent-2);
  }

  .sd__note-text {
    font-size: clamp(1.15rem, 1.6vw, 1.5rem);
    font-weight: 500;
    line-height: 1.3;
    color: #fff;
  }

  .sd__note-text .serif {
    font-size: 1.12em;
    color: var(--accent-2);
  }

  /* Overlay-only pieces stay out of the plain layout. */
  .sd__band,
  .sd__deco,
  .sd__hud,
  .sd__dd {
    display: none;
  }

  /* Hand-drawn sketches on the route (overlay only). */
  .is-overlay .sd__dd {
    display: block;
    position: absolute;
    width: min(calc(var(--w) * 1px), calc(var(--w) / 14.4 * 1vw));
    height: auto;
    overflow: visible;
    translate: -50% -50%;
    pointer-events: none;
  }

  .sd__dd :global(path) {
    fill: none;
    stroke-width: 2;
    stroke-linecap: round;
    stroke-linejoin: round;
    stroke-dasharray: 1;
    stroke-dashoffset: 1;
  }

  .sd__dd :global(.dd-ink) {
    stroke: rgba(255, 255, 255, 0.9);
  }

  .sd__dd :global(.dd-hi) {
    stroke: var(--accent-2);
  }

  .sd__dd :global(.dd-x) {
    stroke: #0b1426;
    stroke-width: 2.6;
  }

  .sd__dd :global(text) {
    opacity: 0;
  }

  .sd__dd :global(.dd-script) {
    font-family: var(--font-serif);
    font-style: italic;
  }

  .sd__dd :global(.dd-block) {
    font-family: var(--font-display);
    font-weight: 800;
    font-stretch: 72%;
    letter-spacing: 0.02em;
  }

  .sd__dd :global(.dd-t-ink) {
    fill: #fff;
  }

  .sd__dd :global(.dd-t-hi) {
    fill: var(--accent-2);
  }

  .sd__dd :global(.dd-t-x) {
    fill: #0b1426;
  }

  /* ----- Overlay mode (JS adds .is-overlay when motion is allowed) ----- */
  .sd.is-overlay {
    position: fixed;
    inset: 0;
    z-index: 100;
    padding: 0;
    visibility: hidden;
    pointer-events: none; /* nothing in it is clickable; never block the page */
  }

  .sd.is-overlay.is-live {
    visibility: visible;
  }

  .is-overlay .sd__canvas {
    position: absolute;
    top: 0;
    left: 0;
    display: block;
    will-change: transform;
  }

  .is-overlay .sd__stop,
  .is-overlay .sd__note {
    position: absolute;
    will-change: transform, opacity;
  }

  .is-overlay .sd__stop {
    width: min(64rem, 88vw);
  }

  .is-overlay .sd__note {
    width: min(25rem, 80vw);
  }

  /* Big strip-sized label shown while the panel is still a band. */
  .is-overlay .sd__band {
    display: block;
    position: absolute;
    left: 0;
    right: 0;
    top: 50%;
    translate: 0 -50%;
    text-align: center;
    font-size: clamp(1.4rem, 7.5vw, 7.5rem);
    line-height: 1;
    white-space: nowrap;
    color: #fff;
  }

  .is-overlay .sd__band--out {
    opacity: 0;
  }

  /* Giant outlined stop numbers, drifting slower than the content. */
  .is-overlay .sd__deco {
    display: block;
    position: absolute;
    top: 0;
    left: 0;
    will-change: transform;
  }

  .sd__num {
    position: absolute;
    font-size: clamp(14rem, 42vh, 30rem);
    line-height: 0.8;
    color: transparent;
    -webkit-text-stroke: 1.5px rgba(255, 255, 255, 0.22);
    translate: -10% -62%;
  }

  /* HUD: track map + stop counter. */
  .is-overlay .sd__hud {
    display: flex;
    position: absolute;
    left: var(--gutter);
    right: var(--gutter);
    bottom: 1.4rem;
    align-items: flex-end;
    gap: 1.25rem;
    font-size: 0.68rem;
    color: rgba(255, 255, 255, 0.8);
  }

  .sd__map {
    width: clamp(110px, 12vw, 170px);
  }

  .sd__map svg {
    display: block;
    width: 100%;
    height: auto;
    overflow: visible;
  }

  .sd__map-path {
    fill: none;
    stroke: rgba(255, 255, 255, 0.45);
    stroke-width: 1.5;
    stroke-dasharray: 4 4;
    vector-effect: non-scaling-stroke;
  }

  .sd__map-stop {
    fill: rgba(255, 255, 255, 0.7);
  }

  .sd__map-note {
    fill: rgba(255, 255, 255, 0.4);
  }

  .sd__map-car {
    fill: var(--accent-2);
  }

  .sd__hud-label {
    padding-bottom: 0.15rem;
  }

  .sd__count {
    margin-left: auto;
    padding-bottom: 0.15rem;
  }

  .sd__count span {
    color: var(--accent-2);
  }

  @media (max-width: 700px) {
    /* Sketches would be thumbnail-sized at the desktop ratio. */
    .is-overlay .sd__dd {
      width: calc(var(--w) / 14.4 * 2.1vw);
    }
    .sd__opts {
      grid-template-columns: minmax(0, 1fr);
      gap: 0.9rem;
    }
    .sd__opt {
      padding-top: 0.6rem;
    }
    .sd__opt-row {
      margin-top: 0.35rem;
      font-size: 0.82rem;
      line-height: 1.35;
    }
    .sd__opt-row .mono {
      display: inline;
      margin-right: 0.4rem;
    }
    .sd__hinge {
      font-size: 1.05rem;
    }
  }
</style>

<script>
  import '@/scripts/system-design';
</script>
