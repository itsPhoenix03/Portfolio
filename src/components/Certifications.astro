---
import { certifications } from '../data/content';
---

<section class="section certs" id="certifications">
  <div class="wrap">
    <header class="sec-head">
      <div class="sec-label" data-reveal>
        <span class="sec-label__idx">(05)</span>
        <span class="sec-label__rule" data-line></span>
        <span data-scramble>Certifications</span>
      </div>
      <h2 class="sec-title display" data-split>
        Verified <span class="serif">credentials</span>
      </h2>
    </header>

    <ol class="certs__list">
      {
        certifications.map((cert, i) => (
          <li data-reveal>
            <a
              class="cert"
              href={cert.credentialUrl ?? '#'}
              target="_blank"
              rel="noopener noreferrer"
              data-cursor="Verify ↗"
            >
              <span class="cert__idx mono">0{i + 1}</span>
              <span class="cert__title">{cert.title}</span>
              <span class="cert__issuer mono">{cert.issuer}</span>
              <span class="cert__arrow" aria-hidden="true">↗</span>
            </a>
          </li>
        ))
      }
    </ol>
  </div>
</section>

<style>
  .certs__list {
    border-top: 1px solid var(--line-strong);
  }

  .cert {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 3rem;
    align-items: center;
    gap: 1.5rem;
    padding: clamp(1.4rem, 3.4vh, 2.2rem) 0.75rem;
    border-bottom: 1px solid var(--line-strong);
    overflow: hidden;
    transition: color 0.5s var(--ease-out);
  }

  .cert::before {
    content: '';
    position: absolute;
    inset: 0;
    z-index: -1;
    background: var(--accent);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.6s var(--ease-out);
  }

  .cert:hover {
    color: var(--on-accent);
  }

  .cert:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .cert__idx {
    color: var(--accent-text);
    transition: color 0.5s var(--ease-out);
  }

  .cert__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 80%;
    font-size: clamp(1.25rem, 2.6vw, 2.4rem);
    line-height: 1.05;
    letter-spacing: -0.01em;
    text-transform: uppercase;
    transition: transform 0.6s var(--ease-out);
  }

  .cert__issuer {
    color: var(--ink-2);
    transition: color 0.5s var(--ease-out);
  }

  .cert__arrow {
    justify-self: end;
    font-size: 1.8rem;
    line-height: 1;
    transition: transform 0.6s var(--ease-out);
  }

  .cert:hover .cert__idx,
  .cert:hover .cert__issuer {
    color: var(--on-accent);
  }

  .cert:hover .cert__title {
    transform: translateX(1rem);
  }

  .cert:hover .cert__arrow {
    transform: rotate(45deg) scale(1.2);
  }

  @media (max-width: 700px) {
    .cert {
      grid-template-columns: 2.2rem minmax(0, 1fr) 2rem;
      gap: 0.4rem 1rem;
    }
    .cert__issuer {
      grid-column: 2;
      grid-row: 2;
    }
    .cert__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
