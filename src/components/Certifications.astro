---
// Compact certifications list, shown under Education at the end of the
// Experience section (see Education.astro). It used to be its own full
// section; for a handful of items a strip reads better and saves a screen.
import { certifications } from '../data/content';
import Arrow from './Arrow.astro';
---

<div class="certs" id="certifications">
  <span class="mono certs__cap" data-reveal>Certifications</span>
  <ol class="certs__list">
    {
      certifications.map((cert, i) => (
        <li data-reveal>
          <a
            class="cert"
            href={cert.credentialUrl ?? '#'}
            target="_blank"
            rel="noopener noreferrer"
            data-cursor="Verify ↗"
          >
            <span class="cert__idx mono">0{i + 1}</span>
            <span class="cert__title">{cert.title}</span>
            <span class="cert__issuer mono">{cert.issuer}</span>
            <span class="cert__arrow" aria-hidden="true"><Arrow /></span>
          </a>
        </li>
      ))
    }
  </ol>
</div>

<style>
  .certs {
    margin-top: clamp(3.5rem, 9vh, 6rem);
  }

  .certs__cap {
    display: block;
    color: var(--ink-3);
    margin-bottom: 1.5rem;
  }

  .certs__list {
    border-top: 1px solid var(--line-strong);
  }

  .cert {
    position: relative;
    isolation: isolate;
    display: grid;
    grid-template-columns: 3rem minmax(0, 1fr) auto 2rem;
    align-items: center;
    gap: 1.5rem;
    /* No side padding, so the numbers line up with Education's above; the
       hover fill reaches a little past the row instead. */
    padding: 1.15rem 0;
    border-bottom: 1px solid var(--line-strong);
    transition: color 0.5s var(--ease-out);
  }

  .cert::before {
    content: '';
    position: absolute;
    inset: 0 -0.75rem;
    z-index: -1;
    background: var(--accent);
    clip-path: inset(100% 0 0 0);
    transition: clip-path 0.6s var(--ease-out);
  }

  .cert:hover {
    color: var(--on-accent);
  }

  .cert:hover::before {
    clip-path: inset(0 0 0 0);
  }

  .cert__idx {
    color: var(--accent-text);
    transition: color 0.5s var(--ease-out);
  }

  .cert__title {
    font-family: var(--font-display);
    font-weight: 700;
    font-stretch: 80%;
    font-size: clamp(1.05rem, 1.6vw, 1.45rem);
    line-height: 1.15;
    letter-spacing: -0.005em;
    text-transform: uppercase;
    transition: transform 0.6s var(--ease-out);
  }

  .cert__issuer {
    color: var(--ink-2);
    transition: color 0.5s var(--ease-out);
  }

  .cert__arrow {
    justify-self: end;
    font-size: 1.3rem;
    line-height: 1;
    transition: transform 0.6s var(--ease-out);
  }

  .cert:hover .cert__idx,
  .cert:hover .cert__issuer {
    color: var(--on-accent);
  }

  .cert:hover .cert__title {
    transform: translateX(0.6rem);
  }

  .cert:hover .cert__arrow {
    transform: rotate(45deg) scale(1.15);
  }

  @media (max-width: 900px) {
    .cert {
      grid-template-columns: 2.5rem minmax(0, 1fr) 1.5rem;
      gap: 0.35rem 1rem;
    }
    .cert__issuer {
      grid-column: 2;
      grid-row: 2;
    }
    .cert__arrow {
      grid-column: 3;
      grid-row: 1;
    }
  }
</style>
