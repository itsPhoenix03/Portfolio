---
import '../styles/global.css';
import { siteMeta, socialLinks } from '../data/content';

export interface Props {
  title?: string;
  description?: string;
}

const {
  title = 'Shreyas Misra — Software Engineer',
  description = 'Shreyas Misra is a software engineer building scalable, dependable web applications with React, Next.js, Node.js and TypeScript.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
const keywords =
  'Shreyas Misra, software engineer, full stack developer, full-stack software engineer, React developer, Next.js developer, Node.js, TypeScript, web developer, frontend developer, backend developer';

// Person structured data helps search engines understand the site / name.
const socialUrls = socialLinks
  .map((s) => s.href)
  .filter((href) => href.startsWith('http'));
const personSchema = {
  '@context': 'https://schema.org',
  '@type': 'Person',
  name: siteMeta.name,
  jobTitle: 'Software Engineer',
  description,
  url: Astro.site?.toString(),
  email: siteMeta.email,
  sameAs: socialUrls,
  knowsAbout: [
    'Software Engineering',
    'Full-Stack Development',
    'TypeScript',
    'JavaScript',
    'React',
    'Next.js',
    'Node.js',
    'MongoDB',
    'System Design',
  ],
};
---

<!doctype html>
<html lang="en">
  <script is:inline>
    // Flag JS early so reveal elements can start hidden without FOUC on no-JS.
    document.documentElement.classList.add('js');
    // Set the theme before first paint to avoid a flash.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteMeta.name} />
    <meta name="robots" content="index, follow, max-image-preview:large" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#e8112d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:locale" content="en_US" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteMeta.name} — ${siteMeta.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />

    <meta name="theme-color" content="#0b1426" />
    <meta name="msapplication-TileColor" content="#0b1426" />

    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(personSchema)}
    />
  </head>
  <body>
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader__top mono">
        <span>{siteMeta.name}</span>
        <span>Portfolio &copy;{new Date().getFullYear()}</span>
      </div>
      <div class="preloader__name display" id="preloader-name">
        Engineering <span class="serif">systems</span><br />that scale.
      </div>
      <div class="preloader__bottom">
        <div class="preloader__bar"><span class="preloader__fill" id="preloader-fill"></span></div>
        <div class="preloader__count display"><span id="preloader-count">0</span></div>
      </div>
    </div>
    <div class="progress" id="scroll-progress" aria-hidden="true"></div>
    <canvas id="hero-canvas" class="bg-canvas" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
