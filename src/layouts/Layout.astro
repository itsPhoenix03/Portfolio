---
import '../styles/global.css';
import { siteMeta, socialLinks, education, experience } from '../data/content';

export interface Props {
  title?: string;
  description?: string;
}

// Title ≈ 60 chars and description ≈ 155, so neither gets cut off in results.
const {
  title = 'Shreyas Misra — Software Engineer | Full-Stack & AI Products',
  description = 'Shreyas Misra is a full-stack software engineer in India building AI-powered products for healthcare and regulatory teams with React, Node.js and Go.',
} = Astro.props;

const canonicalURL = new URL(Astro.url.pathname, Astro.site);
const ogImage = new URL('/og-image.png', Astro.site);
// Google ignores meta keywords, but Bing and others still read them.
const keywords = [
  'Shreyas Misra',
  'Shreyas Misra software engineer',
  'Shreyas Misra portfolio',
  'software engineer India',
  'full stack developer',
  'full-stack software engineer',
  'AI product engineer',
  'generative AI developer',
  'React developer',
  'Next.js developer',
  'Node.js developer',
  'TypeScript developer',
  'Golang developer',
  'system design',
  'Nuvo AI',
  'Meril',
  'IIT Kanpur Technopark',
].join(', ');

// Structured data (schema.org JSON-LD): a profile page about one person,
// with where they work and studied and their other profiles. This is what
// lets Google connect searches for the name to this site and to LinkedIn /
// GitHub, and build a richer result for it.
const site = Astro.site!.toString();
const personId = `${site}#person`;
const socialUrls = socialLinks
  .map((s) => s.href)
  .filter((href) => href.startsWith('http'));
const current = experience.find((job) => job.current) ?? experience[0];

const schema = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'WebSite',
      '@id': `${site}#website`,
      url: site,
      name: siteMeta.name,
      description,
      inLanguage: 'en',
      publisher: { '@id': personId },
    },
    {
      '@type': 'ProfilePage',
      '@id': `${canonicalURL}#profile`,
      url: canonicalURL.toString(),
      name: title,
      description,
      inLanguage: 'en',
      isPartOf: { '@id': `${site}#website` },
      about: { '@id': personId },
      mainEntity: { '@id': personId },
      primaryImageOfPage: ogImage.toString(),
      dateModified: new Date().toISOString(),
    },
    {
      '@type': 'Person',
      '@id': personId,
      name: siteMeta.name,
      givenName: 'Shreyas',
      familyName: 'Misra',
      jobTitle: siteMeta.role,
      description,
      url: site,
      image: new URL('/assets/contact-avatar.png', site).toString(),
      email: `mailto:${siteMeta.email}`,
      sameAs: socialUrls,
      address: { '@type': 'PostalAddress', addressCountry: 'IN' },
      nationality: { '@type': 'Country', name: 'India' },
      worksFor: current && { '@type': 'Organization', name: current.company },
      alumniOf: education.map((ed) => ({ '@type': 'CollegeOrUniversity', name: ed.institution })),
      hasOccupation: {
        '@type': 'Occupation',
        name: siteMeta.role,
        occupationLocation: { '@type': 'Country', name: 'India' },
      },
      knowsAbout: [
        'Software Engineering',
        'Full-Stack Development',
        'Generative AI',
        'AI Product Development',
        'System Design',
        'TypeScript',
        'JavaScript',
        'React',
        'Next.js',
        'Node.js',
        'Go',
        'WebSockets',
        'MongoDB',
        'PostgreSQL',
        'AWS',
      ],
    },
  ],
};
---

<!doctype html>
<html lang="en">
  <script is:inline>
    // Flag JS early so reveal elements can start hidden without FOUC on no-JS.
    document.documentElement.classList.add('js');
    // Set the theme before first paint to avoid a flash.
    (function () {
      try {
        var t = localStorage.getItem('theme');
        if (t !== 'light' && t !== 'dark') {
          t = window.matchMedia('(prefers-color-scheme: light)').matches
            ? 'light'
            : 'dark';
        }
        document.documentElement.dataset.theme = t;
      } catch (e) {
        document.documentElement.dataset.theme = 'dark';
      }
    })();
  </script>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <meta name="description" content={description} />
    <meta name="keywords" content={keywords} />
    <meta name="author" content={siteMeta.name} />
    <meta name="robots" content="index, follow, max-image-preview:large, max-snippet:-1, max-video-preview:-1" />
    <meta name="generator" content={Astro.generator} />

    <link rel="preconnect" href="https://fonts.googleapis.com" />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Archivo:wdth,wght@62..125,100..900&family=Instrument+Serif:ital@0;1&family=JetBrains+Mono:wght@400;500&display=swap" />
    <link rel="manifest" href="/site.webmanifest" />
    <link rel="sitemap" type="application/xml" href="/sitemap.xml" />
    <link rel="canonical" href={canonicalURL} />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="icon" type="image/png" sizes="32x32" href="/favicon-32.png" />
    <link rel="apple-touch-icon" sizes="180x180" href="/apple-touch-icon.png" />
    <link rel="mask-icon" href="/favicon.svg" color="#e8112d" />

    <meta property="og:type" content="website" />
    <meta property="og:site_name" content={siteMeta.name} />
    <meta property="og:locale" content="en_IN" />
    <meta property="og:url" content={canonicalURL} />
    <meta property="og:title" content={title} />
    <meta property="og:description" content={description} />
    <meta property="og:image" content={ogImage} />
    <meta property="og:image:width" content="1200" />
    <meta property="og:image:height" content="630" />
    <meta property="og:image:alt" content={`${siteMeta.name} — ${siteMeta.role}`} />

    <meta name="twitter:card" content="summary_large_image" />
    <meta name="twitter:title" content={title} />
    <meta name="twitter:description" content={description} />
    <meta name="twitter:image" content={ogImage} />
    <meta name="twitter:image:alt" content={`${siteMeta.name} — ${siteMeta.role}`} />

    <meta name="theme-color" content="#0b1426" />
    <meta name="msapplication-TileColor" content="#0b1426" />

    <title>{title}</title>
    <script
      type="application/ld+json"
      set:html={JSON.stringify(schema)}
    />
  </head>
  <body>
    <div class="preloader" id="preloader" aria-hidden="true">
      <div class="preloader__top mono">
        <span>{siteMeta.name}</span>
        <span>Portfolio &copy;{new Date().getFullYear()}</span>
      </div>
      <div class="preloader__name display" id="preloader-name">
        Engineering <span class="serif">systems</span><br />that scale.
      </div>
      <div class="preloader__bottom">
        <div class="preloader__bar"><span class="preloader__fill" id="preloader-fill"></span></div>
        <div class="preloader__count display"><span id="preloader-count">0</span></div>
      </div>
    </div>
    <div class="progress" id="scroll-progress" aria-hidden="true"></div>
    <canvas id="hero-canvas" class="bg-canvas" aria-hidden="true"></canvas>
    <div class="grain" aria-hidden="true"></div>
    <slot />
  </body>
</html>
